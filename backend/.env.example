# OnePlace Backend Environment Configuration Template
PROJECT_NAME="OnePlace API"
ENVIRONMENT=development

# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@localhost:5432/oneplace
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/oneplace

# JWT Security Configuration
SECRET_KEY=oneplace-dev-secret-key-change-in-production-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS & Future Services
CORS_ORIGINS=["*"]
REDIS_URL=
STORAGE_PROVIDER=local
PAYMENT_PROVIDER=cooperative_ledger
